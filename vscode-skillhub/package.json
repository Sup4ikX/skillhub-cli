{
  "name": "vscode-skillhub",
  "displayName": "SkillHub",
  "description": "Universal skill registry for AI coding agents — install, search, and manage skills from VS Code",
  "version": "0.1.0",
  "publisher": "skillhub",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/skillhub/cli"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "skillhub",
    "AI",
    "skills",
    "claude",
    "cursor",
    "opencode"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "skillhub.refresh",
        "title": "Refresh Skills",
        "category": "SkillHub"
      },
      {
        "command": "skillhub.search",
        "title": "Search Registry",
        "category": "SkillHub"
      },
      {
        "command": "skillhub.install",
        "title": "Install Skill",
        "category": "SkillHub"
      },
      {
        "command": "skillhub.uninstall",
        "title": "Uninstall Skill",
        "category": "SkillHub"
      },
      {
        "command": "skillhub.info",
        "title": "Show Skill Info",
        "category": "SkillHub"
      },
      {
        "command": "skillhub.listInstalled",
        "title": "List Installed Skills",
        "category": "SkillHub"
      },
      {
        "command": "skillhub.openSettings",
        "title": "Open Settings",
        "category": "SkillHub"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "skillhub.refresh",
          "group": "navigation",
          "when": "view == skillhubSkills"
        },
        {
          "command": "skillhub.search",
          "group": "navigation",
          "when": "view == skillhubSkills"
        }
      ],
      "view/item/context": [
        {
          "command": "skillhub.info",
          "group": "inline",
          "when": "view == skillhubSkills && viewItem == skill"
        },
        {
          "command": "skillhub.install",
          "group": "inline",
          "when": "view == skillhubSkills && viewItem == skill"
        },
        {
          "command": "skillhub.uninstall",
          "group": "inline",
          "when": "view == skillhubSkills && viewItem == installed"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "skillhubSkills",
          "name": "SkillHub Skills",
          "when": "config.skillhub.enabled"
        }
      ]
    },
    "configuration": {
      "title": "SkillHub",
      "properties": {
        "skillhub.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable SkillHub views and commands"
        },
        "skillhub.binaryPath": {
          "type": "string",
          "default": "skillhub",
          "description": "Path to the skillhub CLI binary"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./tsconfig.json",
    "watch": "tsc -watch -p ./tsconfig.json",
    "lint": "eslint src --ext ts",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.0"
  }
}
